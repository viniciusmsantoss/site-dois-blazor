@page "/media"
@rendermode InteractiveServer

<h3>Calculadora de Média do Aluno</h3>

<div class="mb-3">
    <label class="form-label">Nota 1:</label>
    <input type="number" step="0.1" class="form-control" @bind="nota1" style="width: 200px;" />
</div>

<div class="mb-3">
    <label class="form-label">Nota 2:</label>
    <input type="number" step="0.1" class="form-control" @bind="nota2" style="width: 200px;" />
</div>

<button class="btn btn-primary mb-3" @onclick="CalcularMedia">Calcular Média</button>

@if (media.HasValue)
{
    <h4>Média: @media.Value.ToString("F1")</h4>

    @if (media.Value >= 7.0)
    {
        <p class="text-success fw-bold">Aprovado!</p>
    }
    else
    {
        <p class="text-danger fw-bold">Reprovado!</p>
    }
}

@code {
    private double nota1;
    private double nota2;
    private double? media = null;

    private void CalcularMedia()
    {
        media = (nota1 + nota2) / 2.0;
    }
}