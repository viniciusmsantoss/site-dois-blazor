@page "/conversor"
@rendermode InteractiveServer

<h3>Conversor de Temperatura Simples</h3>

<div class="mb-3">
    <label class="form-label">Temperatura em Celsius (°C):</label>
    <input type="number" class="form-control" @bind="celsius" style="width: 200px;" />
</div>

<button class="btn btn-primary mb-3" @onclick="Converter">Converter</button>

@if (calculado)
{
    <p>Temperatura em Fahrenheit: <strong>@fahrenheit °F</strong></p>
}

@code {
    private double celsius;
    private double fahrenheit;
    private bool calculado = false;

    private void Converter()
    {
        fahrenheit = (celsius * 9 / 5) + 32;
        calculado = true;
    }
}